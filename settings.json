{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cache-tax@claude-optimization": true,
    "cc-plugin-you-should-know@builtin": true,
    "blast-radius@claude-optimization": true,
    "replay-theater@claude-optimization": true,
    "session-usage@claude-optimization": true
  },
  "extraKnownMarketplaces": {
    "claude-optimization": {
      "source": {
        "source": "directory",
        "path": "~/.claude/marketplace"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true
}